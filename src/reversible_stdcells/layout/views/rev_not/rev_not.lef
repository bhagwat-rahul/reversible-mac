VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO rev_not
  CLASS BLOCK ;
  ORIGIN 0 0 ;
  FOREIGN rev_not 0 0 ;
  SIZE 3.680 BY 5.440 ;
  SYMMETRY X Y ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met3 ;
      RECT 0.050 0.140 0.650 0.540 ;
    END
  END VDD
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met3 ;
      RECT 2.090 0.840 2.690 1.240 ;
    END
  END VGND
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER met3 ;
      RECT 0.050 1.540 0.650 1.940 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER met3 ;
      RECT 2.600 2.240 3.200 2.640 ;
    END
  END Y
  OBS
    LAYER li1 ;
    RECT 0.000 0.000 3.680 5.440 ;
    LAYER met1 ;
    RECT 0.000 0.000 3.680 0.240 ;
    RECT 0.690 0.240 1.030 1.210 ;
    RECT 1.765 0.725 1.995 0.870 ;
    RECT 1.710 0.870 2.050 1.220 ;
    RECT 1.765 1.220 1.995 1.375 ;
    RECT 2.215 0.725 2.445 0.870 ;
    RECT 2.215 0.870 2.560 1.220 ;
    RECT 2.215 1.220 2.445 1.375 ;
    RECT 2.730 1.570 3.070 1.800 ;
    RECT 1.920 1.800 3.070 2.030 ;
    RECT 2.730 2.030 3.070 2.085 ;
    RECT 2.730 3.365 3.070 3.420 ;
    RECT 1.920 3.420 3.070 3.650 ;
    RECT 2.730 3.650 3.070 4.010 ;
    RECT 0.000 2.480 1.500 3.220 ;
    RECT 0.690 3.220 1.030 4.710 ;
    RECT 1.765 4.075 1.995 4.230 ;
    RECT 1.710 4.230 2.050 4.710 ;
    RECT 1.765 4.710 1.995 4.725 ;
    RECT 2.215 4.075 2.445 4.230 ;
    RECT 2.215 4.230 2.560 4.710 ;
    RECT 2.215 4.710 2.445 4.725 ;
    LAYER met2 ;
    RECT 0.675 0.855 1.045 1.225 ;
    RECT 2.205 0.855 2.575 1.225 ;
    RECT 2.715 1.555 3.085 1.925 ;
    RECT 2.760 1.925 3.040 3.670 ;
    RECT 2.730 3.670 3.070 4.010 ;
    RECT 1.710 0.870 2.050 1.210 ;
    RECT 1.740 1.210 2.020 2.255 ;
    RECT 1.695 2.255 2.065 2.625 ;
    RECT 1.740 2.625 2.020 4.370 ;
    RECT 1.710 4.370 2.050 4.710 ;
    RECT 0.165 0.155 0.535 0.525 ;
    RECT 0.210 0.525 0.490 4.355 ;
    RECT 0.165 4.355 0.535 4.725 ;
    RECT 0.675 4.355 1.045 4.725 ;
    RECT 2.205 4.355 2.575 4.725 ;
    LAYER met3 ;
    RECT 0.660 0.840 2.090 1.240 ;
    RECT 0.650 1.540 3.100 1.940 ;
    RECT 1.680 2.240 2.600 2.640 ;
    RECT 0.150 4.340 2.590 4.740 ;
  END
END rev_not
END LIBRARY
