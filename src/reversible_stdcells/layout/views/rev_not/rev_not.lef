VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO rev_not
  CLASS BLOCK ;
  ORIGIN 0 0 ;
  FOREIGN rev_not 0 0 ;
  SIZE 3.680 BY 5.440 ;
  SYMMETRY X Y ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER met3 ;
      RECT 0.000 0.140 1.500 0.540 ;
      LAYER met1 ;
      RECT 0.000 2.480 1.500 3.220 ;
      RECT 0.690 3.220 1.030 4.710 ;
    END
  END VDD
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    SHAPE ABUTMENT ;
    PORT
      LAYER met3 ;
      RECT 0.000 0.840 1.500 1.240 ;
      LAYER met1 ;
      RECT 0.000 0.000 3.680 0.240 ;
      RECT 0.690 0.000 1.030 1.210 ;
    END
  END VGND
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER met3 ;
      RECT 0.050 1.540 0.650 1.940 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER met3 ;
      RECT 2.600 2.240 3.200 2.640 ;
    END
  END Y
  OBS
    LAYER li1 ;
    RECT 0.000 0.000 3.680 5.440 ;
    LAYER met1 ;
    RECT 0.000 0.240 0.690 1.210 ;
    RECT 1.030 0.240 3.680 1.210 ;
    RECT 0.000 1.210 3.680 2.480 ;
    RECT 1.500 2.480 3.680 3.220 ;
    RECT 0.000 3.220 0.690 4.710 ;
    RECT 1.030 3.220 3.680 4.710 ;
    RECT 0.000 4.710 3.680 5.440 ;
    LAYER met2 ;
    RECT 0.000 0.000 3.680 5.440 ;
    LAYER met3 ;
    RECT 1.800 0.000 3.680 1.540 ;
    RECT 0.950 1.540 3.680 1.940 ;
    RECT 0.950 1.940 2.300 2.240 ;
    RECT 0.000 2.240 2.300 2.940 ;
    RECT 0.000 2.940 3.680 5.440 ;
  END
END rev_not
END LIBRARY
