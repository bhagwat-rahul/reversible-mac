COMPONENTS 3 ;
    - u_cnot rev_cnot + FIXED ( 23000 33280 ) N ;
    - u_not rev_not + FIXED ( 9200 11520 ) N ;
    - u_toffoli rev_toffoli + FIXED ( 59800 55040 ) N ;
END COMPONENTS
PINS 9 ;
